# Supabase — copiar a .env y completar con valores reales
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Recomendado: service_role para subir a Storage sin tener que armar políticas RLS
# (esta key nunca debe exponerse al frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nombre del bucket en Supabase Storage (default: reproductores)
SUPABASE_BUCKET=reproductores
